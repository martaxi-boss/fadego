# TEMPLATE ONLY. Fill exclusively from the approved VPS vault.
# Ensure a unique staging DB role and database. Use URI-encoded database password.
DATABASE_URL=postgresql://fadego_staging:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/fadego_staging?schema=public
NEXTAUTH_URL=https://fadego.duckdns.org
NEXTAUTH_SECRET=REPLACE_FROM_APPROVED_VPS_VAULT
FADEGO_TRUST_PROXY_HOPS=0

# Email transacional (necessita do remetente/domínio aprovado pelo Owner).
# A API de reservas responde 503 enquanto não estiver configurado.
# Substituir "disabled" por "resend" só após verificar/remeter a chave do cofre.
BOOKING_EMAIL_PROVIDER=disabled
BOOKING_EMAIL_FROM=reservas@REPLACE_WITH_VERIFIED_SENDER_DOMAIN
BOOKING_EMAIL_API_KEY=REPLACE_WITH_VAULT_SECRET
