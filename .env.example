DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
FADEGO_TRUST_PROXY_HOPS=0

# Email da reserva: não aceitar marcações públicas até ativar um remetente
# transacional aprovado e verificado. Nunca comitar a verdadeira chave.
BOOKING_EMAIL_PROVIDER=disabled
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_API_KEY=

# Integração Google Gmail em preparação; os segredos só entram no cofre aprovado.
# Deixe todas as variáveis abaixo vazias/desativadas até aprovação.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_SECRET=
GMAIL_LIVE_SEND_ENABLED=false
# Para futuro teste Gmail: BOOKING_EMAIL_PROVIDER=gmail só após consentimento
# do titular, ambiente HTTPS e autorização explícita do Supervisor.
