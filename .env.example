DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
FADEGO_TRUST_PROXY_HOPS=0

# Cada barbearia liga obrigatoriamente o proprio Gmail por Google OAuth.
# O cliente final apenas indica o email; nao autoriza contas Google.
# Sem envio aprovado, as reservas publicas devolvem EMAIL_UNAVAILABLE.
BOOKING_EMAIL_PROVIDER=disabled

# Apenas nomes de variaveis; credenciais reais ficam no cofre da VPS.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_SECRET=
GMAIL_LIVE_SEND_ENABLED=false

# A passagem para Gmail live exige HTTPS, consentimento e autorizacao separada.
