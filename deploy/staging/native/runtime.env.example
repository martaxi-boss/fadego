# TEMPLATE ONLY. Fill exclusively from the approved VPS vault.
# Ensure a unique staging DB role and database. Use URI-encoded database password.
DATABASE_URL=postgresql://fadego_staging:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/fadego_staging?schema=public
NEXTAUTH_URL=https://fadego.duckdns.org
NEXTAUTH_SECRET=REPLACE_FROM_APPROVED_VPS_VAULT
FADEGO_TRUST_PROXY_HOPS=0

# Gmail-only pilot: this file contains NON-GMAIL app secrets and closed send gates.
# The existing root-only Gmail OAuth credentials are NOT copied here; systemd
# reads /root/project-secrets/fadego-gmail/oauth.env afterwards.
# A missing/incomplete vault blocks Gmail connection; this template cannot
# turn on real customer email.
BOOKING_EMAIL_PROVIDER=disabled
GMAIL_LIVE_SEND_ENABLED=false

# Google callback registered for the later owner-consented HTTPS rehearsal:
# https://fadego.duckdns.org/api/integrations/gmail/callback
# To activate sending later requires separate approval, tenant consent
# and an explicit controlled staging configuration change.
