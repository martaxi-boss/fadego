generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum BarbershopStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantRole {
  OWNER
  ADMIN
  STAFF
}

enum ChairMode {
  WALK_IN
  GENERAL_BOOKING
  STAFF_BOOKING
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_SHOP
  NO_SHOW
  NEEDS_REASSIGNMENT
}

enum BookingMode {
  GENERAL_BOOKING
  STAFF_BOOKING
}

model User {
  id           String             @id @default(uuid())
  name         String?
  email        String             @unique
  passwordHash String
  platformRole PlatformRole       @default(USER)
  active       Boolean            @default(true)
  memberships  BarbershopMember[]
  staffMembers StaffMember[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Barbershop {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique @db.VarChar(63)
  logoUrl             String?
  address             String?
  phone               String?
  instagram           String?
  officialWebsite     String?
  timezone            String?              @db.VarChar(255)
  status              BarbershopStatus     @default(ACTIVE)
  members             BarbershopMember[]
  staffMembers        StaffMember[]
  chairs              Chair[]
  services            Service[]
  openingHours        OpeningHour[]
  customers           Customer[]
  bookings            Booking[]
  bookingAccessTokens BookingAccessToken[]
  membershipPlans     MembershipPlan[]
  membershipPlanServices MembershipPlanService[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model BarbershopMember {
  id           String     @id @default(uuid())
  barbershopId String
  userId       String
  role         TenantRole
  active       Boolean    @default(true)
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([barbershopId, userId])
  @@unique([id, barbershopId])
  @@index([userId, active])
  @@index([barbershopId, active, role])
}

model StaffMember {
  id           String    @id @default(uuid())
  barbershopId String
  userId       String?
  name         String
  photoUrl     String?
  active       Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  chairs     Chair[]    @relation("ChairStaffMember")
  bookings   Booking[]  @relation("BookingStaffMember")

  @@unique([id, barbershopId])
  @@unique([barbershopId, userId])
  @@index([barbershopId, active, archivedAt])
}

model Chair {
  id            String    @id @default(uuid())
  barbershopId  String
  number        Int
  name          String?
  mode          ChairMode
  staffMemberId String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  staffMember StaffMember? @relation("ChairStaffMember", fields: [staffMemberId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  bookings    Booking[]    @relation("BookingChair")

  @@unique([barbershopId, number])
  @@unique([id, barbershopId])
  @@index([barbershopId, active, mode])
}

model Service {
  id              String   @id @default(uuid())
  barbershopId    String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  bookings               Booking[]               @relation("BookingService")
  membershipPlanServices MembershipPlanService[]

  @@unique([id, barbershopId])
  @@index([barbershopId, active])
}

model OpeningHour {
  id           String   @id @default(uuid())
  barbershopId String
  weekday      Int
  opensAt      Int?
  closesAt     Int?
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)

  @@unique([barbershopId, weekday])
  @@unique([id, barbershopId])
  @@index([barbershopId])
}

model Customer {
  id           String   @id @default(uuid())
  barbershopId String
  name         String
  phone        String
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  bookings   Booking[]

  @@unique([id, barbershopId])
  @@index([barbershopId, phone])
  @@index([barbershopId, email])
}

model Booking {
  id                     String        @id @default(uuid())
  barbershopId           String
  customerId             String
  serviceId              String
  chairId                String
  staffMemberId          String?
  mode                   BookingMode
  startsAt               DateTime      @db.Timestamptz(3)
  endsAt                 DateTime      @db.Timestamptz(3)
  status                 BookingStatus @default(CONFIRMED)
  serviceNameSnapshot    String
  serviceDurationMinutes Int
  servicePriceSnapshot   Decimal       @db.Decimal(10, 2)
  customerNameSnapshot   String
  customerPhoneSnapshot  String
  customerEmailSnapshot  String?
  staffNameSnapshot      String?
  chairNumberSnapshot    Int
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  barbershop   Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  customer     Customer             @relation(fields: [customerId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  service      Service              @relation("BookingService", fields: [serviceId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  chair        Chair                @relation("BookingChair", fields: [chairId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  staffMember  StaffMember?         @relation("BookingStaffMember", fields: [staffMemberId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  accessTokens BookingAccessToken[]

  @@unique([id, barbershopId])
  @@index([barbershopId, status, startsAt])
  @@index([chairId, startsAt, endsAt])
  @@index([staffMemberId, startsAt, endsAt])
  @@index([customerId, startsAt])
}

model BookingAccessToken {
  id           String    @id @default(uuid())
  barbershopId String
  bookingId    String
  tokenHash    String    @unique @db.VarChar(64)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  booking    Booking    @relation(fields: [bookingId, barbershopId], references: [id, barbershopId], onDelete: Restrict)

  @@unique([id, barbershopId])
  @@index([barbershopId, bookingId])
  @@index([revokedAt])
}

model MembershipPlan {
  id           String    @id @default(uuid())
  barbershopId String
  name         String
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  benefits     String?
  active       Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  barbershop Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  services   MembershipPlanService[]

  @@unique([id, barbershopId])
  @@index([barbershopId, active, archivedAt])
}

model MembershipPlanService {
  id                 String   @id @default(uuid())
  barbershopId       String
  membershipPlanId   String
  serviceId          String
  usageLimitPerCycle Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  barbershop     Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  membershipPlan MembershipPlan @relation(fields: [membershipPlanId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  service        Service        @relation(fields: [serviceId, barbershopId], references: [id, barbershopId], onDelete: Restrict)

  @@unique([id, barbershopId])
  @@unique([barbershopId, membershipPlanId, serviceId])
  @@index([barbershopId, serviceId])
  @@index([barbershopId, membershipPlanId])
}

model RateLimit {
  key    String  @id @db.VarChar(255)
  points Int     @default(0)
  expire BigInt?
}
